<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>orders_transform</name>
    <description>Read orders CSV, drop non-positive prices, compute line_total, write CSV</description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_FILE</name>
        <default_value>/opt/airflow/work/input/orders.csv</default_value>
        <description>input csv</description>
      </parameter>
      <parameter>
        <name>OUTPUT_FILE</name>
        <default_value>/opt/airflow/work/output/orders_enriched</default_value>
        <description>output path without extension</description>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop><from>Read orders</from><to>Positive price only</to><enabled>Y</enabled></hop>
    <hop><from>Positive price only</from><to>Compute line_total</to><enabled>Y</enabled></hop>
    <hop><from>Compute line_total</from><to>Write enriched</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read orders</name>
    <type>CSVInput</type>
    <filename>${INPUT_FILE}</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>order_id</name><type>Integer</type><format>#</format><currency/><decimal/><group/><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>region</name><type>String</type><format/><currency/><decimal/><group/><length>20</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>unit_price</name><type>Number</type><format>#.##</format><currency/><decimal>.</decimal><group>,</group><length>15</length><precision>2</precision><trim_type>none</trim_type></field>
      <field><name>quantity</name><type>Integer</type><format>#</format><currency/><decimal/><group/><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>80</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <name>Positive price only</name>
    <type>FilterRows</type>
    <send_true_to/>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>unit_price</leftvalue>
        <function>&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Number</type>
          <text>0</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>#</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>240</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <name>Compute line_total</name>
    <type>Calculator</type>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <field_name>line_total</field_name>
      <calc_type>MULTIPLY</calc_type>
      <field_a>unit_price</field_a>
      <field_b>quantity</field_b>
      <field_c/>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <attributes/>
    <GUI><xloc>420</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <name>Write enriched</name>
    <type>TextFileOutput</type>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${OUTPUT_FILE}</name>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
      <field><name>order_id</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision></field>
      <field><name>region</name><type>String</type><format/><length>20</length><precision>-1</precision></field>
      <field><name>unit_price</name><type>Number</type><format>0.00</format><decimal>.</decimal><group/><length>15</length><precision>2</precision></field>
      <field><name>quantity</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision></field>
      <field><name>line_total</name><type>Number</type><format>0.00</format><decimal>.</decimal><group/><length>-1</length><precision>2</precision></field>
    </fields>
    <attributes/>
    <GUI><xloc>600</xloc><yloc>80</yloc></GUI>
  </transform>
  <notepads/>
</pipeline>
