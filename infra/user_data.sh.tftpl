#!/bin/bash
# Runs once at first boot. Installs Docker, then hands off to deploy.sh (re-runnable by CI via SSM).
set -euxo pipefail
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins /opt/pf
curl -fsSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
# 2 GiB swap as headroom for JVM + Airflow on a 4 GiB host
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
fi
echo "BUCKET=${bucket}" > /opt/pf/env
echo "PREFIX=${prefix}" >> /opt/pf/env
aws s3 cp s3://${bucket}/app/deploy.sh /opt/pf/deploy.sh
chmod +x /opt/pf/deploy.sh
/opt/pf/deploy.sh
